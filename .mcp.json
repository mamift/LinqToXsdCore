{
  "mcpServers": {
    "code-review-graph": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "cwd": "."
    },
    "fuse": {
      "type": "stdio",
      "command": "fuse",
      "args": [
        "mcp",
        "serve"
      ]
    }
  }
}
