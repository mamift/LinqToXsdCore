<?xml version="1.0" encoding="utf-8"?>
<Configuration xmlns="http://www.microsoft.com/xml/schema/linq">
  <CodeGeneration>
    <UseDateOnly>false</UseDateOnly>
    <UseTimeOnly>false</UseTimeOnly>
    <UseDateTimeOffset>false</UseDateTimeOffset>
    <NullableReferences>false</NullableReferences>
    <SplitCodeFiles By="Namespace" />
  </CodeGeneration>
  <Namespaces AlwaysPrefixGlobal="true">
    <Namespace Schema="http://www.microsoft.com/xml/schema/linq" Clr="Xml.Schema.Linq" DefaultVisibility="public" />
  </Namespaces>
  <NullableReferences>false</NullableReferences>
  <Validation>
    <VerifyRequired>false</VerifyRequired>
  </Validation>
  <Transformation>
    <Deanonymize strict="true" />
  </Transformation>
</Configuration>