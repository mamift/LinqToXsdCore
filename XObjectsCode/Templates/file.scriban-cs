{{- if Settings.NullableReferences }}
#nullable enable annotations
{{- end }}

{{~ for $ns in Namespaces ~}}
namespace {{ $ns.Name }} {
    using System;
    using System.Collections;
    using System.Collections.Generic;
    using System.ComponentModel;
    using System.IO;
    using System.Linq;
    using System.Diagnostics;
    using System.Xml;
