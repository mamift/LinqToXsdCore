    {{- end -}}

    {{- if !$ns.Roots.empty? }}
    {{ include 'root.scriban-cs' XRoot:'XRootNamespace' prefix:'' roots:$ns.Roots accessModifier:$ns.AccessModifier }}
    {{- end -}}

    {{- if XRoot.Namespace == $ns }}
    {{ include 'root.scriban-cs' XRoot:'XRoot' prefix:('global::' + $ns.Name + '.') roots:XRoot.AllRoots accessModifier:$ns.AccessModifier }}
    {{- end }}
}
{{ end # for $ns }}