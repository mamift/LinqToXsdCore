            {{~ if $validatorType == null ~}}
            this.SetValue(value, XmlSchemaType.GetBuiltInSimpleType({{ $simple | xml_type_code }}).Datatype);
            {{~ else ~}}
            this.SetValueWithValidation(value, "TypedValue", {{ $validatorType }}.TypeDefinition);
            {{~ end ~}}
        }
    }
    
