    [EditorBrowsable(EditorBrowsableState.Never)]
    protected internal static readonly System.Xml.Linq.XName {{ $prop.Name }}XName = System.Xml.Linq.XName.Get("{{ $1 | local_name $prop.Name + 'XName' }}", "{{ $1 | namespace $prop.Name + 'XName' }}");

    {{- 
        $default = $prop | default_value $1
        if $default 
    }}

