{{ $1.Comments | comments '///' -}}
{{ if Settings.EnableServiceReference }}
[XmlSchemaProviderAttribute("{{$1.Name}}SchemaProvider")]
{{ end -}}
{{
    $1.Namespace?.AccessModifier ?? "public"
    $1.IsAbstract ? " abstract" : ""
    $1.IsSealed ? " sealed" : ""
    " partial class "
    $1.Name
    " : "
    $1.BaseTypeName
    ", IXMetaData"
    Settings.EnableServiceReference ? ", IXmlSerializable" : ""
}} {

    {{- if $1.HasSaveMethods }}

    public void Save(string xmlFile) {
        XTypedServices.Save(xmlFile, Untyped);
    }
    
    public void Save(System.IO.TextWriter tw) {
        XTypedServices.Save(tw, Untyped);
    }
    
    public void Save(System.Xml.XmlWriter xmlWriter) {
        XTypedServices.Save(xmlWriter, Untyped);
    }

    {{- end -}}

    {{-
        if $1.HasLoadMethods
            if $1.IsAbstract || $1.IsSubstitutionHead
    }}

    public static {{ $1.Name }} Load(string xmlFile) {
        return (({{ $1.Name }})(XTypedServices.ToXTypedElement(XElement.Load(xmlFile), LinqToXsdTypeManager.Instance)));
    }

    public static {{ $1.Name }} Load(System.IO.TextReader xmlFile) {
        return (({{ $1.Name }})(XTypedServices.ToXTypedElement(XElement.Load(xmlFile), LinqToXsdTypeManager.Instance)));
    }
    
    public static {{ $1.Name }} Parse(string xml) {
        return (({{ $1.Name }})(XTypedServices.ToXTypedElement(XElement.Parse(xml), LinqToXsdTypeManager.Instance)));
    }

    {{- # TODO: when InnerType, generic type <$1.Name> must adapted and a 2nd parameter with SingletonTypeManager must be added ~}}
    {{- 
            else # if IsAbstract || IsSubstitutionHead 
                $new = $1.IsDerived ? "new " : ""
    }}

    public {{ $new -}} static {{ $1.Name }} Load(string xmlFile) {
        return XTypedServices.Load<{{ $1.Name }}>(xmlFile);
    }

    {{~ # FIXME: $new missing here, but I'm matching legacy 1:1 codegen for now ~}}
    public static {{ $1.Name }} Load(System.IO.TextReader xmlFile) {
        return XTypedServices.Load<{{ $1.Name }}>(xmlFile);
    }
    
    public {{ $new -}} static {{ $1.Name }} Parse(string xml) {
        return XTypedServices.Parse<{{ $1.Name }}>(xml);
    }

    {{- 
            end # if IsAbstract || IsSubstitutionHead
        end # if HasLoadMethods 
    }}

    public static explicit operator {{ $1.Name }}(XElement xe) { {{
        if $1.IsAbstract || $1.IsSubstitutionHead # match weird double-space in legacy code
        }} return ({{ $1.Name }})XTypedServices.ToXTypedElement
        {{- else # TODO: handle <$1.Name> for nested types -}}
            return XTypedServices.ToXTypedElement<{{ $1.Name }}>
        {{- end
    -}}(xe,LinqToXsdTypeManager.Instance as ILinqToXsdTypeManager); }

    {{- if !$1.IsAbstract }}

    public override XTypedElement Clone() {
        {{~ # TODO: return new $1(($1.InnerType)this.Content.Clone); when InnerType  ~}}
        return XTypedServices.CloneXTypedElement<{{ $1.Name }}>(this);
    }
    {{- end }}

    {{ $1.Comments | comments '///' -}}
    public {{ $1.Name }}() {
        {{~ # TODO: review CreateDEfaultConstructor for Wrapper types ~}}
    }

    {{- 
        for $nested in $1.Types; 
            # FIXME: this loop is duplicated below for nested complex types, 
            #        we should simplify as declaration order has no importance 
            #        but for now I want to match legacy output 1:1
            if !$nested.IsSimpleType; continue; end 
    }}

    {{ include 'simple-type.scriban-cs' $nested }}
    {{- end }}

    {{- for $content in $1.Content }}
    {{- if $content.IsAny }}

    {{ $content.Comments | array.concat $1.RegexComments | comments '///' -}}
    public virtual IEnumerable<XElement> Any {
        get {
            return this.GetWildCards(WildCard.DefaultWildCard);
        }
    }
    {{- continue; end }}
    {{ include 'attribute.scriban-cs' $content $1 }}
    {{- end }}

    {{- for $choice in $1.ChoiceConstructors }}

    public {{ $1.Name }}({{ $choice.Type }} {{ $choice.Name }}) {
        this.{{ $choice.Name }} = {{ $choice.Name }};
    }

    {{- end }}

    private static readonly System.Xml.Linq.XName xName = System.Xml.Linq.XName.Get({{ $1.XName | string.literal }}, {{ $1.XNamespace | string.literal }});
    
    {{- if $1.HasWildcard }}
    
    [DebuggerBrowsable(DebuggerBrowsableState.Never)]
    private static FSM validationStates;

    FSM IXMetaData.GetValidationStates() {
        return validationStates;
    }

    private static void InitFSM() {
        Dictionary<int, Transitions> transitions = new Dictionary<int, Transitions>();
        {{- for $state in $1.FSMStates }}
        transitions.Add({{ $state.State }}, new Transitions({{
            for $tran in $state.Transitions
                if !for.first; ", "; end
                "new SingleTransition("
                if $tran.WildCard
                    "new WildCard("
                    $tran.WildCardNs | string.literal
                    ", "
                    $tran.WildCardTargetNs | string.literal
                    ")"
                else
                    "System.Xml.Linq.XName.Get("
                    $tran.XName.LocalName | string.literal
                    ", "
                    $tran.XName.Namespace.NamespaceName | string.literal
                    ")"
                end
                ", "
                $tran.State
                ")"
            end
        }}));
        {{- end }}
        validationStates = new FSM({{ $1.FSMStartState }}, new Set<int>(
            {{-
                if $1.FSMAcceptStates | array.size == 1 
                    $1.FSMAcceptStates | array.first
                else
                    "new int[] {"
            }}
            {{
                    # new code block for indentation of new lines
                    $1.FSMAcceptStates | array.join ",\n"
                    "}"
                end # if FSMAcceptStates
            -}}
            ), transitions);
    }

    static {{ $1.Name }}() {
        InitFSM();
    }

    {{- else }}

    {{- if !$1.LocalElements.empty? || $1.HasGroups }}

    static {{ $1.Name }}() {
        {{- if !$1.LocalElements.empty? }}
        BuildElementDictionary();
        {{- end }}
        {{- 
            if $1.HasContentModel
                func entity
                    case $0.Type
                        when 'Sequence'
                            "new SequenceContentModelEntity("
                            for $c in $0.Children
                                if !for.first; ", "; end
                                $c | entity
                            end
                            ")"
                            
                        when 'Choice'
                            "new ChoiceContentModelEntity("
                            for $c in $0.Children
                                if !for.first; ", "; end
                                $c | entity
                            end
                            ")"

                        when 'Named'
                            "new NamedContentModelEntity(" + $0.XNameField + ")"

                        when 'Substituted'
                            "new SubstitutedContentModelEntity("
                            for $s in $0.SubstitutionMembers
                                if !for.first; ", "; end
                                'System.Xml.Linq.XName.Get(' 
                                $s.QualifiedName.Name | string.literal
                                ', '
                                $s.QualifiedName.Namespace | string.literal 
                                ')'
                            end
                            ")"
                    end
                end
        }}
        contentModel = {{ $1.Group | entity }};
        {{- end }}
    }
    {{- end # if LocalsElement || Groups }}

    {{- if !$1.LocalElements.empty? }}

    [DebuggerBrowsable(DebuggerBrowsableState.Never)]
    private static Dictionary<System.Xml.Linq.XName, System.Type> localElementDictionary = new Dictionary<System.Xml.Linq.XName, System.Type>();
    
    private static void BuildElementDictionary() {
        {{- for $attr in $1.LocalElements }}
        localElementDictionary.Add({{ $attr.XNameField }}, typeof({{ $attr.ClrType | builtin }}));
        {{- end }}
    }
    
    [DebuggerBrowsable(DebuggerBrowsableState.Never)]
    Dictionary<System.Xml.Linq.XName, System.Type> IXMetaData.LocalElementsDictionary {
        get {
            return localElementDictionary;
        }
    }

    {{- end }}
    
    {{- if $1.HasContentModel }}

    [DebuggerBrowsable(DebuggerBrowsableState.Never)]
    private static ContentModelEntity contentModel;
        
    ContentModelEntity IXMetaData.GetContentModel() {
        return contentModel;
    }

    {{- else if !$1.IsDerived }}

    ContentModelEntity IXMetaData.GetContentModel() {
        return ContentModelEntity.Default;
    }

    {{- 
        # else IsDerived: probably derived by restriction, use base content model 
        end # if HasContentModel
        end # if HasWildcard
    }}

    [DebuggerBrowsable(DebuggerBrowsableState.Never)]
    System.Xml.Linq.XName IXMetaData.SchemaName {
        get {
            return xName;
        }
    }
    
    [DebuggerBrowsable(DebuggerBrowsableState.Never)]
    SchemaOrigin IXMetaData.TypeOrigin {
        get {
            return SchemaOrigin.{{ $1.Origin }};
        }
    }
    
    [DebuggerBrowsable(DebuggerBrowsableState.Never)]
    ILinqToXsdTypeManager IXMetaData.TypeManager {
        get {
            return LinqToXsdTypeManager.Instance;
        }
    }
        
    {{- if Settings.EnableServiceReference }}

    public static {{ $1.Origin == "Element" ? "XmlSchemaType" : "XmlQualifiedName" }} {{ $1.Name }}SchemaProvider() {
        LinqToXsdTypeManager.AddSchemas(schemas);
        {{~ if $1.Origin == "Element" ~}}
        XmlSchemaElement element = (XmlSchemaElement)schemas.GlobalElements[new XmlQualifiedName({{ $1.XName | string.literal }}, {{ $1.XNamespace | string.literal }})];
        if (element != null) { 
            return element.ElementSchemaType; 
        } 
        return null;
        {{~ else ~}}
        return new XmlQualifiedName({{ $1.XName | string.literal }}, {{ $1.XNamespace | string.literal }});
        {{~ end ~}}
    }

    {{- end }}

    {{- 
        for $nested in $1.Types; 
            # FIXME: this loop is duplicated above for nested simple types, 
            #        we should simplify as declaration order has no importance 
            #        but for now I want to match legacy output 1:1
            if $nested.IsSimpleType; continue; end 
    }}

    {{ include 'class.scriban-cs' $nested }}
    {{- end }}
}