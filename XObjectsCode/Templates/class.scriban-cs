                return null;
            }
            {{- end }}
            return (({{ $prop.Type | type_name }})(x));
        }
        set {
            this.SetElement({{ $prop.Name }}XName, value);
        }

        {{- else }}
        get {
            XAttribute x = this.Attribute({{ $prop.Name }}XName);
            {{- if $prop | is_optional }}
            if ((x == null)) {
